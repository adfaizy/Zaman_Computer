{
 "ownerDash": "<!-- ═══════════ OWNER DASHBOARD (Owner Mode only) ═══════════ -->\n<section class=\"section\" id=\"ownerDash\" hidden aria-labelledby=\"ownerTitle\">\n  <div class=\"container\">\n    <div class=\"section-head\">\n      <div>\n        <span class=\"eyebrow\">Owner Access</span>\n        <h2 id=\"ownerTitle\">Owner <em>Dashboard</em></h2>\n        <p>Update prices, add or remove products, then <b>Publish</b> to push the catalog live for customers on GitHub Pages.</p>\n      </div>\n      <button class=\"btn btn-ghost btn-sm\" id=\"ownerSignOutBtn\" type=\"button\">Sign Out</button>\n    </div>\n\n    <div class=\"owner-stats\" id=\"ownerStats\" aria-live=\"polite\"></div>\n\n    <div class=\"owner-actions\">\n      <button class=\"btn btn-gold btn-sm\" id=\"ownerAddBtn\" type=\"button\">+ Add Product</button>\n      <button class=\"btn btn-ink btn-sm\" id=\"ownerPublishBtn\" type=\"button\">&#11014; Publish to GitHub</button>\n      <button class=\"btn btn-ghost btn-sm\" id=\"ownerExportBtn\" type=\"button\">&#8681; Export JSON</button>\n      <label class=\"btn btn-ghost btn-sm\" for=\"ownerImportFile\" style=\"cursor:pointer\">&#8679; Import JSON</label>\n      <input type=\"file\" id=\"ownerImportFile\" accept=\"application/json,.json\" hidden>\n    </div>\n\n    <details class=\"owner-publish\">\n      <summary>Publish settings <small>(set once — stored only on this device)</small></summary>\n      <div class=\"form-row\" style=\"margin-top:.6rem\">\n        <div class=\"field\"><label for=\"ghOwner\">GitHub owner</label><input id=\"ghOwner\" value=\"adfaizy\" autocomplete=\"off\"></div>\n        <div class=\"field\"><label for=\"ghRepo\">Repository</label><input id=\"ghRepo\" value=\"Zaman_Computer\" autocomplete=\"off\"></div>\n      </div>\n      <div class=\"form-row\">\n        <div class=\"field\"><label for=\"ghBranch\">Branch</label><input id=\"ghBranch\" value=\"main\" autocomplete=\"off\"></div>\n        <div class=\"field\"><label for=\"ghPath\">Catalog file</label><input id=\"ghPath\" value=\"products.json\" autocomplete=\"off\"></div>\n      </div>\n      <div class=\"field\"><label for=\"ghToken\">GitHub token (contents:write)</label><input id=\"ghToken\" type=\"password\" placeholder=\"ghp_…\" autocomplete=\"off\"></div>\n      <p class=\"form-note\" style=\"margin:0\">Create a <b>fine-grained PAT</b> on github.com → Settings → Developer settings → Personal access tokens → fine-grained → Repository access: only <code>Zaman_Computer</code> → Permissions: <code>Contents: Read and write</code>. It is stored only in this browser and never sent anywhere except github.com.</p>\n      <label class=\"checkline\" style=\"margin-top:.6rem\"><input type=\"checkbox\" id=\"rememberToken\"> Remember settings on this device</label>\n    </details>\n\n    <div class=\"owner-pin-row\">\n      <input id=\"ownerNewPin\" type=\"password\" inputmode=\"numeric\" maxlength=\"8\" placeholder=\"New PIN (4–8 digits)\" autocomplete=\"off\" aria-label=\"New owner PIN\">\n      <button class=\"btn btn-ghost btn-sm\" id=\"ownerChangePinBtn\" type=\"button\">Change PIN</button>\n    </div>\n\n    <div class=\"table-scroll\">\n      <table class=\"owner-table\" aria-label=\"Edit product prices and stock\">\n        <thead><tr><th>SKU</th><th>Product</th><th class=\"num\">Price</th><th>Cond.</th><th>In Stock</th><th>★</th><th></th></tr></thead>\n        <tbody id=\"ownerTableBody\"></tbody>\n      </table>\n    </div>\n    <p class=\"form-note\" style=\"margin-top:.6rem\">Edits save instantly on this device. Tap <b>Publish to GitHub</b> to make the catalog live for customers (GitHub Pages rebuilds in ~1 minute).</p>\n  </div>\n</section>",
 "invoice": "<!-- ═══════════ INVOICE & QR CENTER ═══════════ -->\n<section class=\"section alt\" id=\"invoice\" aria-labelledby=\"invoiceTitle\" hidden>\n  <div class=\"container\">\n    <div class=\"section-head\">\n      <div>\n        <span class=\"eyebrow\">Shop Management</span>\n        <h2 id=\"invoiceTitle\">Invoice &amp; <em>QR Code Center</em></h2>\n        <p>Bill customers in seconds — auto totals, amount in words, FBR/NTN footer and a printable bill. Also print QR labels for your stock. Works fully offline.</p>\n      </div>\n    </div>\n\n    <div class=\"invoice-tabs\" role=\"tablist\">\n      <button class=\"invoice-tab active\" id=\"tabBtnInvoice\" role=\"tab\" aria-selected=\"true\" aria-controls=\"tabInvoice\" data-tab=\"tabInvoice\">Create Invoice</button>\n      <button class=\"invoice-tab\" id=\"tabBtnBarcode\" role=\"tab\" aria-selected=\"false\" aria-controls=\"tabBarcode\" data-tab=\"tabBarcode\">QR Code</button>\n    </div>\n\n    <!-- TAB 1 · INVOICE BUILDER -->\n    <div class=\"tab-panel\" id=\"tabInvoice\" role=\"tabpanel\" aria-labelledby=\"tabBtnInvoice\">\n      <div class=\"invoice-wrap\">\n        <form class=\"form-card\" id=\"invoiceForm\">\n          <div class=\"form-row\">\n            <div class=\"field\"><label for=\"invCustomer\">Customer Name <b>*</b></label><input id=\"invCustomer\" required placeholder=\"Walk-in customer / company\"></div>\n            <div class=\"field\"><label for=\"invPhone\">Customer Phone <small style=\"color:var(--muted);text-transform:none;letter-spacing:0\">(for WhatsApp — 03xx-xxxxxxx)</small></label><input id=\"invPhone\" type=\"tel\" inputmode=\"numeric\" placeholder=\"0301-1234567\"></div>\n          </div>\n          <div class=\"form-row\">\n            <div class=\"field\" style=\"grid-column:1/-1\"><label for=\"invOrg\">Customer Organization <small style=\"color:var(--muted);text-transform:none;letter-spacing:0\">(optional — e.g. university, company)</small></label><input id=\"invOrg\" placeholder=\"e.g. University of Lahore, XYZ (Pvt) Ltd\"></div>\n          </div>\n          <div class=\"form-row\">\n            <div class=\"field\"><label for=\"invType\">Bill Type</label><select id=\"invType\"><option>Retail Sale</option><option>Service Job / Repair</option><option>Custom PC Build</option><option>Installation Service</option><option>CCTV Installation</option></select></div>\n            <div class=\"field\"><label for=\"invPayment\">Payment Method</label><select id=\"invPayment\"><option>Cash</option><option>Bank Transfer</option><option>Easypaisa</option><option>JazzCash</option><option>Debit / Credit Card</option></select></div>\n          </div>\n          <div class=\"form-row\">\n            <div class=\"field\"><label for=\"invDate\">Invoice Date</label><input id=\"invDate\" type=\"date\"></div>\n            <div class=\"field\"><label for=\"invNo\">Invoice No. (auto)</label><input id=\"invNo\" readonly aria-readonly=\"true\" style=\"opacity:.75\"></div>\n          </div>\n\n          <div class=\"field\">\n            <label for=\"invProduct\">Add Product From Catalog</label>\n            <div style=\"display:flex;gap:.5rem\">\n              <select id=\"invProduct\" style=\"flex:1;background:var(--card-2);border:1px solid var(--border);border-radius:10px;color:var(--text);padding:.7rem .8rem;min-width:0\"></select>\n              <input id=\"invQty\" type=\"number\" min=\"1\" value=\"1\" aria-label=\"Quantity\" style=\"width:72px;background:var(--card-2);border:1px solid var(--border);border-radius:10px;color:var(--text);padding:.7rem .6rem;text-align:center\">\n              <button type=\"button\" class=\"btn btn-gold btn-sm\" id=\"invAddProduct\">Add</button>\n            </div>\n          </div>\n          <div class=\"field\">\n            <label for=\"invCustomDesc\">Or Add Custom Line (parts, labor, services)</label>\n            <div style=\"display:flex;gap:.5rem\">\n              <input id=\"invCustomDesc\" placeholder=\"e.g. Laptop keyboard replacement\" style=\"flex:1;background:var(--card-2);border:1px solid var(--border);border-radius:10px;color:var(--text);padding:.7rem .8rem;min-width:0\">\n              <input id=\"invCustomRate\" type=\"number\" min=\"0\" placeholder=\"Rs.\" aria-label=\"Rate in rupees\" style=\"width:110px;background:var(--card-2);border:1px solid var(--border);border-radius:10px;color:var(--text);padding:.7rem .6rem\">\n              <button type=\"button\" class=\"btn btn-ink btn-sm\" id=\"invAddCustom\">Add</button>\n            </div>\n          </div>\n\n          <table class=\"line-items\" aria-label=\"Invoice line items\">\n            <thead><tr><th>#</th><th>Item</th><th class=\"num\">Qty</th><th class=\"num\">Rate</th><th class=\"num\">Amount</th><th></th></tr></thead>\n            <tbody id=\"invItemsBody\"><tr id=\"invEmptyRow\"><td colspan=\"6\" style=\"color:var(--muted);text-align:center;padding:1.1rem\">No items yet — add from catalog or a custom line.</td></tr></tbody>\n          </table>\n\n          <div class=\"totals\">\n            <div class=\"row\"><span>Subtotal</span><span id=\"invSubtotal\">Rs. 0</span></div>\n            <div class=\"row\"><span>Owner Discount</span><span style=\"display:flex;align-items:center;gap:.35rem\"><input id=\"invDiscount\" type=\"number\" min=\"0\" value=\"0\" aria-label=\"Owner discount in rupees\" style=\"width:104px;text-align:right;background:var(--card-2);border:1px solid var(--border);border-radius:8px;color:var(--text);padding:.2rem .5rem\"><input id=\"invDiscountPct\" class=\"pct-input\" type=\"number\" min=\"0\" max=\"100\" value=\"0\" aria-label=\"Owner discount in percent\" placeholder=\"%\" style=\"background:var(--card-2);border:1px solid var(--border);border-radius:8px;color:var(--gold-2);padding:.2rem .35rem\"></span></div>\n            <label class=\"checkline\"><input type=\"checkbox\" id=\"invTax\"> Add Sales Tax 18% <small style=\"color:var(--muted)\">(owner not registered for Sales Tax — leave off)</small></label>\n            <div class=\"row\"><span>Sales Tax (GST)</span><span id=\"invTaxAmt\">Rs. 0</span></div>\n            <div class=\"row grand\"><span>Grand Total</span><span id=\"invGrand\">Rs. 0</span></div>\n          </div>\n          <div class=\"field\" style=\"margin-top:.6rem\"><label for=\"invNotes\">Notes / Warranty</label><textarea id=\"invNotes\" rows=\"2\" placeholder=\"e.g. 7-day shop warranty on repaired parts…\"></textarea></div>\n          <div style=\"display:flex;gap:.6rem;flex-wrap:wrap;margin-top:.2rem\">\n            <button type=\"button\" class=\"btn btn-gold\" id=\"invPrint\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M6 9V2h12v7\"/><path d=\"M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2\"/><rect x=\"6\" y=\"14\" width=\"12\" height=\"8\" rx=\"1\"/></svg> Print Invoice</button>\n            <button type=\"button\" class=\"btn btn-wa\" id=\"invSharePdf\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z\"/><path d=\"M14 2v6h6M16 13H8M16 17H8M10 9H8\"/></svg> Send PDF via WhatsApp</button>\n            <button type=\"button\" class=\"btn btn-ink\" id=\"invDownloadPdf\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4\"/><path d=\"M7 10l5 5 5-5\"/><path d=\"M12 15V3\"/></svg> Download PDF</button>\n            <button type=\"button\" class=\"btn btn-ghost btn-sm\" id=\"invWA\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M21 11.5a8.5 8.5 0 0 1-8.5 8.5c-1.5 0-3-.4-4.2-1.1L3 20l1.2-5.1A8.5 8.5 0 1 1 21 11.5z\"/></svg> Text Summary</button>\n            <button type=\"button\" class=\"btn btn-ink btn-sm\" id=\"invClear\">Clear</button>\n          </div>\n        </form>\n\n        <div class=\"form-card\" id=\"invoicePreviewWrap\" aria-label=\"Invoice preview\">\n          <div class=\"invoice-paper\" id=\"invoicePreview\"></div>\n        </div>\n      </div>\n    </div>\n\n    <!-- TAB 2 · QR CODE -->\n    <div class=\"tab-panel\" id=\"tabBarcode\" role=\"tabpanel\" aria-labelledby=\"tabBtnBarcode\" hidden>\n      <div class=\"invoice-wrap\">\n        <form class=\"form-card\" id=\"barcodeForm\">\n          <p class=\"form-note\">Generates a QR code any phone camera scans instantly — product SKU, a warranty link, or any custom text (max 80 characters).</p>\n          <div class=\"field\"><label for=\"bcProduct\">From Catalog (uses SKU)</label><select id=\"bcProduct\"><option value=\"\">— custom code below —</option></select></div>\n          <div class=\"field\"><label for=\"bcCustom\">Or Custom Text</label><input id=\"bcCustom\" placeholder=\"e.g. ZC-L001 · wa.me/923084608380\" maxlength=\"80\" spellcheck=\"false\"></div>\n          <label class=\"checkline\"><input type=\"checkbox\" id=\"bcShowName\" checked> Show product name</label>\n          <label class=\"checkline\"><input type=\"checkbox\" id=\"bcShowPrice\" checked> Show price (Rs.)</label>\n          <div style=\"display:flex;gap:.6rem;flex-wrap:wrap;margin-top:.8rem\">\n            <button type=\"button\" class=\"btn btn-gold\" id=\"bcRender\">Preview QR Code</button>\n            <button type=\"button\" class=\"btn btn-ink\" id=\"bcDownload\">Download PNG</button>\n            <button type=\"button\" class=\"btn btn-ghost\" id=\"bcPrint\">Print Label</button>\n          </div>\n        </form>\n        <div class=\"form-card barcode-lab-preview\" style=\"display:flex;justify-content:center\" aria-label=\"QR code label preview\">\n          <div style=\"text-align:center;background:#fdfcf8;color:#111;border-radius:10px;padding:1.2rem 1.6rem;box-shadow:var(--shadow);width:100%;max-width:360px\">\n            <div style=\"font-family:var(--font-display);font-weight:800;letter-spacing:.08em\">ZAMAN COMPUTER</div>\n            <div id=\"bcLabelName\" style=\"font-size:.78rem;margin:.15rem 0 .4rem;min-height:1.2em\">—</div>\n            <div class=\"barcode-row\"><canvas id=\"barcodeCanvas\" aria-label=\"QR code preview\"></canvas></div>\n            <div id=\"bcLabelPrice\" style=\"font-weight:700;margin-top:.35rem;font-size:.95rem\">—</div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n</section>",
 "priceEditor": "<!-- Price Manager (Owner) -->\n<div class=\"pe-overlay\" id=\"priceEditor\" hidden role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"peTitle\">\n  <div class=\"pe-card\">\n    <div class=\"pe-head\">\n      <h3 id=\"peTitle\">Price Manager — Lahore Market</h3>\n      <button class=\"pe-close\" id=\"closePriceEditor\" aria-label=\"Close price manager\">×</button>\n    </div>\n    <p class=\"form-note\" style=\"padding:.7rem 1.3rem 0;margin:0\">Enter today&rsquo;s market rates in PKR. Saved on this device and applied instantly across the shop, invoices and WhatsApp messages.</p>\n    <div class=\"pe-list\" id=\"peList\"></div>\n    <div class=\"pe-foot\">\n      <button class=\"btn btn-ghost btn-sm\" id=\"resetPricesBtn\" type=\"button\">Reset to defaults</button>\n      <button class=\"btn btn-gold\" id=\"savePricesBtn\" type=\"button\">Save Today&rsquo;s Rates</button>\n    </div>\n  </div>\n</div>",
 "unlockModal": "<!-- Owner Unlock -->\n<div class=\"pe-overlay\" id=\"ownerUnlockModal\" hidden role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"unlockTitle\">\n  <div class=\"pe-card\" style=\"max-width:400px\">\n    <div class=\"pe-head\">\n      <h3 id=\"unlockTitle\">Owner Access</h3>\n      <button class=\"pe-close\" id=\"ownerUnlockClose\" aria-label=\"Close\">&times;</button>\n    </div>\n    <div class=\"pe-list\" style=\"padding-top:.9rem\">\n      <p class=\"form-note\">Private area for the shop owner. Enter your PIN to manage products, prices and invoices. Customers never see this screen.</p>\n      <input id=\"ownerPinInput\" class=\"pin-input\" type=\"password\" inputmode=\"numeric\" maxlength=\"8\" autocomplete=\"off\" placeholder=\"PIN\" aria-label=\"Owner PIN\">\n      <button class=\"btn btn-gold btn-block\" id=\"ownerUnlockBtn\" type=\"button\">Unlock Dashboard</button>\n      <p class=\"form-note\" style=\"margin:0\">First time? Default PIN is <b>1234</b> — change it immediately in the dashboard.</p>\n    </div>\n  </div>\n</div>",
 "addProduct": "<!-- Add Product -->\n<div class=\"pe-overlay\" id=\"addProductModal\" hidden role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"addTitle\">\n  <div class=\"pe-card\">\n    <div class=\"pe-head\">\n      <h3 id=\"addTitle\">Add Product</h3>\n      <button class=\"pe-close\" id=\"addProductClose\" aria-label=\"Close\">&times;</button>\n    </div>\n    <form id=\"addProductForm\" class=\"pe-list\" style=\"gap:.55rem;padding-top:.8rem\">\n      <div class=\"form-row\">\n        <div class=\"field\"><label for=\"apSku\">SKU</label><input id=\"apSku\" required autocomplete=\"off\" placeholder=\"ZC-L021\"></div>\n        <div class=\"field\"><label for=\"apCategory\">Category</label><select id=\"apCategory\" required><option value=\"desktops\">Desktops &amp; Systems</option><option value=\"laptops\">Laptops</option><option value=\"accessories\">Accessories</option><option value=\"hardware\">Hardware &amp; Components</option><option value=\"security\">CCTV &amp; Security</option></select></div>\n      </div>\n      <div class=\"field\"><label for=\"apName\">Product Name <b>*</b></label><input id=\"apName\" required placeholder=\"e.g. HP ProBook 440 G10 — Core i5\"></div>\n      <div class=\"form-row\">\n        <div class=\"field\"><label for=\"apBrand\">Brand</label><input id=\"apBrand\" placeholder=\"HP\"></div>\n        <div class=\"field\"><label for=\"apCond\">Condition</label><select id=\"apCond\"><option>New</option><option>Used</option></select></div>\n      </div>\n      <div class=\"field\"><label for=\"apSpecs\">Key Specifications</label><input id=\"apSpecs\" placeholder=\"i5-1335U · 16GB · 512GB NVMe · 14&quot; FHD\"></div>\n      <div class=\"form-row\">\n        <div class=\"field\"><label for=\"apPrice\">Price (Rs.) <b>*</b></label><input id=\"apPrice\" type=\"number\" min=\"0\" step=\"100\" required placeholder=\"165000\" inputmode=\"numeric\"></div>\n        <div class=\"field\"><label for=\"apOldPrice\">Old Price (Rs.) <small>(optional)</small></label><input id=\"apOldPrice\" type=\"number\" min=\"0\" step=\"100\" placeholder=\"192000\" inputmode=\"numeric\"></div>\n      </div>\n      <div class=\"field\"><label for=\"apImg\">Image URL <small>(optional — leave blank for chip image)</small></label><input id=\"apImg\" type=\"url\" placeholder=\"https://images.unsplash.com/photo-…\" autocomplete=\"off\"></div>\n      <div class=\"form-row\" style=\"gap:1.2rem\">\n        <label class=\"checkline\"><input type=\"checkbox\" id=\"apStock\" checked> In stock</label>\n        <label class=\"checkline\"><input type=\"checkbox\" id=\"apFeatured\"> ★ Featured</label>\n        <label class=\"checkline\"><input type=\"checkbox\" id=\"apIsNew\"> New Arrival</label>\n      </div>\n      <button type=\"submit\" class=\"btn btn-gold btn-block\" style=\"margin-top:.2rem\">Add to Catalog</button>\n    </form>\n  </div>\n</div>"
}